# Copy to .env.local for development. Never commit real values.

# Neon Postgres connection string (pooled). Leave unset locally to use the
# built-in PGlite database stored in .data/pglite.
DATABASE_URL=

# Random string used to hash IPs and emails for rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
RATE_LIMIT_SALT=
